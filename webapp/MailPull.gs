/* Private Drive pull; no Drive writes, no public endpoint, no programmatic trigger creation. */

function mailPullConfig_(){const p=PropertiesService.getScriptProperties().getProperties();if(p.LEDGER_MODE!=='personal'||!p.LEDGER_SPREADSHEET_ID||!p.OWNER_EMAIL||Session.getEffectiveUser().getEmail().toLowerCase()!==p.OWNER_EMAIL.toLowerCase())throw Error('OWNER_ONLY');return p;}
function mailPrivateOwner_(file,p){if(file.getOwner()?.getEmail().toLowerCase()!==p.OWNER_EMAIL.toLowerCase()||file.getSharingAccess()!==DriveApp.Access.PRIVATE||file.getEditors().some(u=>u.getEmail().toLowerCase()!==p.OWNER_EMAIL.toLowerCase())||file.getViewers().some(u=>u.getEmail().toLowerCase()!==p.OWNER_EMAIL.toLowerCase()))throw Error('MAIL_INBOX_NOT_PRIVATE');}
function mailInbox_(p){if(!p.MAIL_INBOX_FOLDER_ID||!p.MAIL_INBOX_PARENT_ID)throw Error('MAIL_INBOX_NOT_CONFIGURED');const folder=DriveApp.getFolderById(p.MAIL_INBOX_FOLDER_ID);mailPrivateOwner_(folder,p);const parents=folder.getParents();let parent=false;while(parents.hasNext())if(parents.next().getId()===p.MAIL_INBOX_PARENT_ID)parent=true;if(!parent)throw Error('MAIL_INBOX_PARENT_CHANGED');return folder;}
// Run from the owner editor ONLY after the owner explicitly grants the new consent.
// Read-only authorization probe. Does not create triggers or import anything.
function authorizeMailInbox_(){const p=mailPullConfig_();mailInbox_(p);return {ok:true,folder_id:p.MAIL_INBOX_FOLDER_ID,read_only:true,imports:0};}
function readMailFiles_(p,seenRequests){const folder=mailInbox_(p),files=folder.getFiles(),out=[];let scanned=0;while(files.hasNext()){const f=files.next();if(++scanned>1000)throw Error('MAIL_INBOX_SCAN_LIMIT');if(f.getMimeType()!=='application/json'||!/^exchange-[-a-zA-Z0-9_]+\.json$/.test(f.getName()))continue;mailPrivateOwner_(f,p);if(f.getSize()>500000)throw Error('MAIL_FILE_TOO_LARGE');const text=f.getBlob().getDataAsString('UTF-8');let input;try{input=JSON.parse(text);}catch(e){throw Error('MAIL_INVALID_JSON');}const content_digest=sha_(text),requestId='mailpull-'+sha_(f.getId()+'|'+content_digest);if((seenRequests||[]).some(r=>r.id===requestId))continue;out.push({file_id:f.getId(),content_digest,input});if(out.length>100)throw Error('MAIL_INBOX_BATCH_LIMIT');}return out.sort((a,b)=>String(a.input.generated_at).localeCompare(String(b.input.generated_at))||a.file_id.localeCompare(b.file_id));}
function previewMailInbox(){const p=configuration_();return lock_(()=>{const b=read_(p),files=readMailFiles_(p,b.requests),out=[];let state=b.state;for(const f of files){const id='mailpull-'+sha_(f.file_id+'|'+f.content_digest),old=b.requests.find(x=>x.id===id);if(old){out.push({file_id:f.file_id,replayed:true});continue;}const x=KakeiboMailExchange.plan(state,f.input,mailTools_(p),new Date().toISOString());state=x.state;state.mail_exchange_log=(state.mail_exchange_log||[]).concat([{run_id:x.report.run_id,at:new Date().toISOString(),report:x.report}]);out.push({file_id:f.file_id,report:x.report});}return {ok:true,revision:b.revision,files:out,read_only:true};});}
// Eligible for an owner-created time-driven trigger. No active browser user is required.
// The trigger must be created separately after consent; this file does not install one.
function pullMailInbox_(){const p=mailPullConfig_();return lock_(()=>{const baseline=read_(p),files=readMailFiles_(p,baseline.requests),out=[];for(const f of files){const before=read_(p),requestId='mailpull-'+sha_(f.file_id+'|'+f.content_digest),command={type:'applyMailExchange',exchangeFile:f.input},req={requestId,expectedRevision:before.revision,command},digest='u8v1:'+sha_(JSON.stringify({file_id:f.file_id,content_digest:f.content_digest}));const result=KakeiboCore.transact(before,req,new Date().toISOString(),before.state.as_of,digest,{...mailTools_(p),executionPath:'head_pull'});if(!result.replayed)Sheets.Spreadsheets.batchUpdate({requests:KakeiboStore.requests(KakeiboStore.encode(result.snapshot),sheets_(p.LEDGER_SPREADSHEET_ID))},p.LEDGER_SPREADSHEET_ID);out.push({file_id:f.file_id,replayed:result.replayed,revision:result.snapshot.revision});}return {ok:true,files:out};});}

// Public function name is required by the editor's manual trigger selector; app remains MYSELF.
function processMailInbox(){return pullMailInbox_();}
